<%- include('partials/header', { title: 'Notifications | NUCLEA ERP' }) %>
<%- include('partials/sidebar', { page: 'notifications' }) %>
<div class="app-wrapper"><%- include('partials/headbar') %><main class="app-main container-fluid py-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><h3 class="fw-bold mb-1">Notifications</h3><div class="text-muted small">Workflow updates for your account</div></div><form method="POST" action="/notifications/read-all"><button class="btn btn-outline-primary" type="submit">Mark all read</button></form></div>
  <% if (query && query.success) { %><div class="alert alert-success"><%= query.success %></div><% } %>
  <div class="card border-0 shadow-sm"><div class="list-group list-group-flush">
    <% if (rows.length) { rows.forEach(n => { %>
      <div class="list-group-item p-3 <%= n.is_read ? 'opacity-75' : '' %>"><div class="d-flex gap-3 align-items-start"><span class="rounded-circle d-inline-flex align-items-center justify-content-center bg-<%= n.type==='danger'?'danger':n.type==='warning'?'warning':n.type==='success'?'success':n.type==='approval'?'primary':'secondary' %> bg-opacity-10 text-<%= n.type==='danger'?'danger':n.type==='warning'?'warning':n.type==='success'?'success':n.type==='approval'?'primary':'secondary' %>" style="width:42px;height:42px;flex:0 0 42px"><i class="bi bi-<%= n.type==='approval'?'clipboard-check':n.type==='danger'?'exclamation-octagon':n.type==='warning'?'exclamation-triangle':n.type==='success'?'check-circle':'bell' %>"></i></span><div class="flex-grow-1 min-w-0"><div class="d-flex flex-wrap justify-content-between gap-2"><strong><%= n.title || 'ERP notification' %></strong><small class="text-muted"><%= n.created_at ? new Date(n.created_at).toLocaleString('en-GB') : '' %></small></div><div class="text-muted small mt-1"><%= n.message || '' %></div><div class="d-flex flex-wrap gap-3 mt-2"><% if (n.action_url) { %><a class="small fw-semibold text-decoration-none" href="<%= n.action_url %>">Open related module <i class="bi bi-arrow-up-right"></i></a><% } %><% if (!n.is_read) { %><form method="POST" action="/notifications/<%= n.id %>/read" class="m-0"><button class="btn btn-sm btn-link p-0 text-decoration-none" type="submit">Mark read</button></form><% } %></div></div></div></div>
    <% }) } else { %><div class="text-center text-muted p-5"><i class="bi bi-bell-slash fs-2 d-block mb-2"></i>No notifications yet.</div><% } %>
  </div></div>
</main></div><%- include('partials/footer') %>
