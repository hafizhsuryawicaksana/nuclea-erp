<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Recovery | NUCLEA ERP</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <style>
    :root{--navy:#132b4b;--blue:#2563eb;--muted:#65758b;--line:#dce5ef}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#edf3fa url('/background.jpg') center/cover fixed;font-family:Inter,system-ui,sans-serif;color:#132238}
    .recovery-card{width:min(100%,520px);background:#fff;border:1px solid rgba(220,229,239,.9);border-radius:18px;box-shadow:0 25px 70px rgba(15,35,65,.18);padding:clamp(24px,5vw,40px)}
    .brand{display:flex;align-items:center;gap:12px;margin-bottom:28px}.brand img{max-width:82px;max-height:54px;object-fit:contain}.brand span{font-weight:800;letter-spacing:.02em;color:var(--navy)}
    h1{font-size:1.5rem;font-weight:800;letter-spacing:-.04em;margin:0 0 8px}.sub{font-size:.9rem;color:var(--muted);line-height:1.55;margin:0 0 24px}.section{padding-top:22px;margin-top:22px;border-top:1px solid var(--line)}.section h2{font-size:.94rem;font-weight:750;margin:0 0 6px}.section p{font-size:.8rem;color:var(--muted);margin:0 0 16px;line-height:1.5}.form-label{font-size:.78rem;font-weight:700}.form-control{min-height:43px;border-radius:9px}.btn-primary{background:var(--blue);border-color:var(--blue);font-weight:700;min-height:42px;border-radius:9px}.bottom-link{font-size:.84rem;color:var(--blue);font-weight:700;text-decoration:none}.bottom-link:hover{text-decoration:underline}
  </style>
</head>
<body>
  <main class="recovery-card">
    <div class="brand"><img src="/logo.png" alt="NUCLEA ERP"><span>Account Recovery</span></div>
    <h1>Reset your password</h1>
    <p class="sub">A short-lived verification code will be sent to the registered email address, when it exists and email delivery is configured.</p>
    <% if (query && query.sent) { %><div class="alert alert-success small" role="status">If the account is active, reset instructions have been sent. In local development without SMTP, check the Node.js terminal for the code.</div><% } %>
    <% if (query && query.error) { %><div class="alert alert-danger small" role="alert"><%= query.error %></div><% } %>
    <section class="section" style="border-top:0;padding-top:0;margin-top:0">
      <h2>1. Request a reset code</h2>
      <p>Use the email address registered with NUCLEA ERP.</p>
      <form action="/auth/forgot-password/request" method="POST">
        <div class="mb-3"><label class="form-label" for="requestEmail">Email address</label><input type="email" name="email" id="requestEmail" class="form-control" maxlength="100" required autocomplete="email"></div>
        <button type="submit" class="btn btn-primary w-100">Send reset code</button>
      </form>
    </section>
    <section class="section">
      <h2>2. Set a new password</h2>
      <p>Code expires after 10 minutes. Password must be at least 10 characters, with uppercase, lowercase and a number.</p>
      <form action="/auth/forgot-password/confirm" method="POST">
        <div class="mb-3"><label class="form-label" for="resetEmail">Registered email</label><input type="email" name="email" id="resetEmail" class="form-control" maxlength="100" required autocomplete="email"></div>
        <div class="mb-3"><label class="form-label" for="resetOtp">6-digit reset code</label><input type="text" name="otp" id="resetOtp" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"></div>
        <div class="mb-3"><label class="form-label" for="newPassword">New password</label><input type="password" name="new_password" id="newPassword" class="form-control" minlength="10" required autocomplete="new-password"></div>
        <button type="submit" class="btn btn-primary w-100">Reset password</button>
      </form>
    </section>
    <div class="text-center mt-4"><a class="bottom-link" href="/auth/login"><i class="bi bi-arrow-left me-1"></i> Back to login</a></div>
  </main>
</body>
</html>
