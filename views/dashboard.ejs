<%- include('partials/header', { title: 'Dashboard | NUCLEA ERP' }) %>
<%- include('partials/sidebar', { page: 'dashboard' }) %>
<div class="app-wrapper">
  <%- include('partials/headbar') %>
  <main class="app-main dashboard-page dash-simple">
    <%
      const fmt = v => Number(v || 0).toLocaleString('en-US');
      const money = v => Number(v || 0).toLocaleString('en-US', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 });
      const fmtDuration = seconds => {
        const minutes = Math.floor(Number(seconds || 0) / 60);
        return minutes >= 60 ? `${Math.floor(minutes / 60)}h ${minutes % 60}m` : `${minutes}m`;
      };
      const lowStock = (inventory || []).slice(0, 3);
      const monthData = (batchTrendMonth || []).map(x => ({ label: x.label, value: Number(x.value || 0) }));
      const yearData = (batchTrendYear || []).map(x => ({ label: x.label, value: Number(x.value || 0) }));
      const growth = (revenueGrowth || []).map(x => ({ year: Number(x.year), revenue: Number(x.revenue || 0) }));
      const growthTotal = growth.reduce((sum, x) => sum + x.revenue, 0);
      const dashCan = code => !(user && user._erpCustomRole) || !!(user._erpRolePermissions && user._erpRolePermissions[code] && user._erpRolePermissions[code].can_view === true);
      const currentYear = Number(dashboardYear || new Date().getFullYear());
      const firstName = user && user.full_name ? user.full_name.trim().split(/\s+/)[0] : 'User';
      const hasCashAdvance = (typeof cashAdvance !== 'undefined' && cashAdvance !== null) || (typeof cashAdvanceTotal !== 'undefined' && cashAdvanceTotal !== null);
      const cashAdvanceValue = typeof cashAdvance !== 'undefined' ? cashAdvance : (typeof cashAdvanceTotal !== 'undefined' ? cashAdvanceTotal : null);
    %>

    <% if (query && query.error) { %><div class="alert alert-danger dash-alert"><%= query.error %></div><% } %>
    <% if (query && query.success) { %><div class="alert alert-success dash-alert"><%= query.success %></div><% } %>

    <section class="dash-head">
      <div class="dash-head-copy">
        <h1>Welcome back, <%= firstName %></h1>
        <p class="dash-date"><%= new Date().toLocaleDateString('en-US', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
      </div>
      <nav class="dash-jump" aria-label="Quick access">
        <% if (dashCan('MANUFACTURING_PLANNING')) { %><a class="btn btn-sm btn-outline-secondary" href="/manufacturing/planning"><i class="bi bi-calendar2-week"></i>Production planning</a><% } %>
        <% if (dashCan('MANUFACTURING_EXECUTION')) { %><a class="btn btn-sm btn-outline-secondary" href="/manufacturing/execution"><i class="bi bi-play-circle"></i>Production execution</a><% } %>
        <% if (dashCan('INVENTORY')) { %><a class="btn btn-sm btn-outline-secondary" href="/inventory"><i class="bi bi-boxes"></i>Inventory</a><% } %>
        <% if (dashCan('DISTRIBUTION')) { %><a class="btn btn-sm btn-outline-secondary" href="/erp/distribution"><i class="bi bi-truck"></i>Distribution</a><% } %>
      </nav>
    </section>

    <section class="dash-kpis" aria-label="Business overview">
      <article class="dash-kpi kpi-output">
        <span class="kpi-label">Production Output</span>
        <strong><%= fmt(productionOutput) %></strong>
      </article>
      <article class="dash-kpi kpi-revenue">
        <span class="kpi-label">Annual Revenue</span>
        <strong class="kpi-money"><%= money(annualRevenue) %></strong>
      </article>
      <article class="dash-kpi kpi-expense">
        <span class="kpi-label">Annual Expenses</span>
        <strong class="kpi-money"><%= money(annualExpenses) %></strong>
      </article>
      <article class="dash-kpi kpi-customers">
        <span class="kpi-label"><%= hasCashAdvance ? 'Cash Advance' : 'Total Customers' %></span>
        <strong class="<%= hasCashAdvance ? 'kpi-money' : '' %>"><%= hasCashAdvance ? money(cashAdvanceValue) : fmt(totalCustomers) %></strong>
      </article>
    </section>

    <section class="dash-grid dash-grid-top">
      <article class="dash-panel trend-panel">
        <header class="dash-panel-head">
          <h2>Production Batch Trend</h2>
          <div class="dash-period" role="group" aria-label="Production period">
            <button type="button" data-trend-range="month">Month</button>
            <button type="button" data-trend-range="year" class="is-active">Year</button>
          </div>
        </header>
        <div class="dash-chart dash-chart-trend"><canvas id="batchTrendChart" aria-label="Production batch trend"></canvas></div>
      </article>

      <article class="dash-panel users-panel">
        <header class="dash-panel-head"><h2>Active Users Ranking</h2></header>
        <div class="dash-user-list">
          <% if ((activeUsers || []).length) { %>
            <% activeUsers.forEach((u, i) => { %>
              <div class="dash-user">
                <span class="dash-user-rank"><%= i + 1 %></span>
                <div class="dash-user-avatar"><%= String(u.full_name || 'U').split(/\s+/).slice(0, 2).map(x => x[0] || '').join('').toUpperCase() %></div>
                <div class="dash-user-name"><strong><%= u.full_name %></strong><small><%= u.role || 'User' %></small></div>
                <b><%= fmtDuration(u.active_seconds) %></b>
              </div>
            <% }) %>
          <% } else { %><div class="dash-empty">No activity yet</div><% } %>
        </div>
      </article>
    </section>

    <section class="dash-grid dash-grid-bottom">
      <article class="dash-panel revenue-panel">
        <header class="dash-panel-head">
          <h2>Revenue Growth</h2>
          <strong class="revenue-total"><%= money(growthTotal) %></strong>
        </header>
        <div class="dash-chart dash-chart-revenue"><canvas id="revenueGrowthChart" aria-label="Revenue growth over five years"></canvas></div>
      </article>

      <div class="dash-side-stack">
        <article class="dash-panel">
          <header class="dash-panel-head">
            <h2>Material Requisition</h2>
            <% if (dashCan('MATERIAL_REQUISITION')) { %><a class="dash-text-link" href="/material-requisition">View all requests</a><% } %>
          </header>
          <div class="dash-request-list">
            <% if ((oldestRequests || []).length) { %>
              <% oldestRequests.slice(0, 5).forEach(r => { %>
                <div class="dash-request">
                  <div><strong><%= r.item_name %></strong><small><%= r.requester_name %><% if (r.department) { %>, <%= r.department %><% } %></small></div>
                  <time><%= r.created_at ? new Date(r.created_at).toLocaleDateString('en-US', { day: '2-digit', month: 'short' }) : '-' %></time>
                </div>
              <% }) %>
            <% } else { %><div class="dash-empty">No requests</div><% } %>
          </div>
        </article>

        <article class="dash-panel stock-panel">
          <header class="dash-panel-head">
            <h2>Minimum Stock Alert</h2>
            <% if (dashCan('INVENTORY')) { %><a class="dash-text-link" href="/inventory">Open inventory</a><% } %>
          </header>
          <div class="dash-stock-list">
            <% if (lowStock.length) { %>
              <% lowStock.forEach(m => { %>
                <div class="dash-stock-row">
                  <span class="dash-stock-marker"></span>
                  <div class="dash-stock-name"><strong><%= m.name %></strong><small>Min. <%= fmt(m.min_stock) %> <%= m.uom || '' %></small></div>
                  <b><%= fmt(m.current_stock) %> <small><%= m.uom || '' %></small></b>
                </div>
              <% }) %>
            <% } else { %><div class="dash-empty dash-healthy">Stock levels healthy</div><% } %>
          </div>
        </article>
      </div>
    </section>

    <script>
    (() => {
      const monthData = <%- JSON.stringify(monthData) %>;
      const yearData = <%- JSON.stringify(yearData) %>;
      const growth = <%- JSON.stringify(growth) %>;
      const trendCanvas = document.getElementById('batchTrendChart');
      const revenueCanvas = document.getElementById('revenueGrowthChart');
      if (!trendCanvas || !revenueCanvas || typeof Chart === 'undefined') return;

      const css = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      const isDark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark' || document.body.classList.contains('dark-mode');
      const pal = () => ({ primary: css('--nu-primary') || '#0A76A8', ok: css('--st-ok') || '#17825A', tip: css('--lead-800') || '#162733', sheet: css('--nu-sheet') || '#fff' });
      const gridColor = () => css('--nu-hair') || 'rgba(42,66,105,.08)';
      const textColor = () => css('--nu-muted') || '#566878';
      if (css('--f-body')) Chart.defaults.font.family = css('--f-body');
      const numberFormat = new Intl.NumberFormat('en-US');
      const currencyFormat = value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'IDR', notation: 'compact', maximumFractionDigits: 1 }).format(Number(value || 0));
      let trendChart = null;
      let revenueChart = null;
      let range = 'year';

      function formatLabel(value, selectedRange) {
        if (selectedRange === 'month') {
          const date = new Date(value + 'T12:00:00');
          return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('en-US', { day: 'numeric', month: 'short' });
        }
        const date = new Date(value + '-01T12:00:00');
        return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('en-US', { month: 'short' });
      }

      function drawTrend(nextRange) {
        range = nextRange;
        const source = range === 'month' ? monthData : yearData;
        if (trendChart) trendChart.destroy();
        const ctx = trendCanvas.getContext('2d');
        const c = pal();
        const areaGradient = ctx.createLinearGradient(0, 0, 0, trendCanvas.height || 280);
        areaGradient.addColorStop(0, c.primary + '33');
        areaGradient.addColorStop(1, c.primary + '04');
        const values = source.map(item => item.value);
        trendChart = new Chart(trendCanvas, {
          type: 'line',
          data: {
            labels: source.map(item => formatLabel(item.label, range)),
            datasets: [{
              label: 'Production batches',
              data: values,
              borderColor: c.primary,
              backgroundColor: areaGradient,
              fill: 'origin',
              tension: .3,
              cubicInterpolationMode: 'monotone',
              spanGaps: true,
              borderWidth: 2.5,
              borderCapStyle: 'round',
              borderJoinStyle: 'round',
              pointStyle: 'circle',
              pointRadius: context => context.dataIndex === values.length - 1 ? 5 : (range === 'month' ? 2.5 : 3),
              pointHoverRadius: 7,
              pointBackgroundColor: context => context.dataIndex === values.length - 1 ? c.primary : c.sheet,
              pointBorderColor: c.primary,
              pointBorderWidth: context => context.dataIndex === values.length - 1 ? 3 : 2,
              pointHoverBackgroundColor: c.sheet,
              pointHoverBorderColor: c.primary,
              pointHoverBorderWidth: 3
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 650, easing: 'easeOutQuart' },
            interaction: { intersect: false, mode: 'index' },
            elements: { line: { capBezierPoints: true } },
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: c.tip,
                titleColor: '#fff',
                bodyColor: '#D6E0E8',
                padding: 11,
                cornerRadius: 7,
                displayColors: false,
                callbacks: { label: context => `${numberFormat.format(context.parsed.y)} batches` }
              }
            },
            scales: {
              x: {
                grid: { display: false },
                border: { display: false },
                ticks: { color: textColor(), maxTicksLimit: range === 'month' ? 8 : 12, maxRotation: 0, font: { size: 10 }, padding: 8 }
              },
              y: {
                beginAtZero: true,
                grid: { color: gridColor(), drawTicks: false },
                border: { display: false },
                ticks: { color: textColor(), precision: 0, padding: 9, font: { size: 10 } }
              }
            }
          }
        });
        document.querySelectorAll('[data-trend-range]').forEach(button => button.classList.toggle('is-active', button.dataset.trendRange === range));
      }

      function drawRevenue() {
        if (revenueChart) revenueChart.destroy();
        const ctx = revenueCanvas.getContext('2d');
        const c = pal();
        const fill = ctx.createLinearGradient(0, 0, 0, 260);
        fill.addColorStop(0, c.ok + '33');
        fill.addColorStop(1, c.ok + '04');
        revenueChart = new Chart(revenueCanvas, {
          type: 'line',
          data: {
            labels: growth.map(item => String(item.year)),
            datasets: [{
              data: growth.map(item => item.revenue),
              borderColor: c.ok,
              backgroundColor: fill,
              fill: true,
              tension: .32,
              pointRadius: 4,
              pointHoverRadius: 6,
              pointBackgroundColor: c.ok,
              pointBorderColor: c.sheet,
              pointBorderWidth: 2,
              borderWidth: 2.5
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 400 },
            plugins: {
              legend: { display: false },
              tooltip: { backgroundColor: c.tip, titleColor: '#fff', bodyColor: '#D6E0E8', cornerRadius: 7, displayColors: false, callbacks: { label: context => currencyFormat(context.parsed.y) } }
            },
            scales: {
              x: { grid: { display: false }, border: { display: false }, ticks: { color: textColor(), font: { size: 10 } } },
              y: { beginAtZero: true, grid: { color: gridColor(), drawTicks: false }, border: { display: false }, ticks: { color: textColor(), callback: value => currencyFormat(value), padding: 8, font: { size: 10 } } }
            }
          }
        });
      }

      document.querySelectorAll('[data-trend-range]').forEach(button => button.addEventListener('click', () => drawTrend(button.dataset.trendRange)));
      drawTrend(range);
      drawRevenue();
      window.addEventListener('themeChanged', () => { drawTrend(range); drawRevenue(); });
    })();
    </script>

    <style>
      /* Dashboard — layout only. Colour, type and radii come from /css/nuclea-ds.css tokens. */
      .dash-simple{--ds-line:var(--nu-hair);--ds-muted:var(--nu-muted);background:transparent!important}
      .dash-simple .dash-alert{margin-bottom:1rem}
      .dash-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem 1.5rem;margin-bottom:1.35rem}
      .dash-head h1{margin:0;font-size:clamp(1.6rem,2.4vw,2.15rem);font-weight:700;letter-spacing:-.032em}
      .dash-date{margin:.35rem 0 0;color:var(--ds-muted);font-size:.9rem}
      .dash-jump{display:flex;flex-wrap:wrap;gap:.5rem}
      /* one continuous instrument strip instead of four identical cards */
      .dash-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:1rem;overflow:hidden;background:var(--nu-sheet);border:1px solid var(--nu-line);border-radius:var(--r-sheet)}
      .dash-kpi{container-type:inline-size;display:flex;flex-direction:column;justify-content:space-between;gap:.85rem;min-width:0;min-height:118px;padding:1.1rem 1.35rem 1.2rem;border-left:1px solid var(--ds-line)}
      .dash-kpi:first-child{border-left:0}
      .kpi-label{display:flex;align-items:center;gap:.5rem;font-size:.8125rem;font-weight:500;color:var(--ds-muted);line-height:1.3}
      .kpi-label::before{content:"";flex:0 0 8px;height:8px;border-radius:2px;background:var(--kpi-color,var(--nu-primary))}
      .dash-kpi strong{font-family:var(--f-display);font-size:clamp(1.7rem,2.3vw,2.3rem);font-weight:700;line-height:1.05;letter-spacing:-.04em;color:var(--bs-emphasis-color);overflow-wrap:break-word}
      /* currency never breaks mid-number: it shrinks with its cell instead */
      .dash-kpi .kpi-money{font-size:clamp(.95rem,1.2vw,1.25rem);letter-spacing:-.03em;white-space:nowrap}
      @supports (font-size:1cqi){.dash-kpi .kpi-money{font-size:clamp(.95rem,7.2cqi,1.6rem)}}
      .kpi-output{--kpi-color:var(--nu-primary)}.kpi-revenue{--kpi-color:var(--st-ok)}.kpi-expense{--kpi-color:var(--st-warn)}.kpi-customers{--kpi-color:var(--st-hold)}
      .dash-grid{display:grid;gap:1rem;margin-bottom:1rem}
      .dash-grid-top{grid-template-columns:minmax(0,1.55fr) minmax(300px,.85fr)}
      .dash-grid-bottom{grid-template-columns:minmax(0,1.2fr) minmax(320px,.9fr);align-items:stretch}
      .dash-panel{min-width:0;overflow:hidden;background:var(--nu-sheet);border:1px solid var(--nu-line);border-radius:var(--r-sheet)}
      .dash-panel-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:54px;padding:.8rem 1.1rem;border-bottom:1px solid var(--ds-line)}
      .dash-panel-head h2{margin:0;font-size:.95rem;font-weight:650;letter-spacing:-.012em}
      .dash-period{--seg-on-bg:var(--lead-800);--seg-on-fg:#fff;display:flex;align-items:center;gap:2px;padding:3px;border-radius:var(--r-control);background:var(--nu-sunken);border:1px solid var(--ds-line)}
      [data-bs-theme="dark"] .dash-period{--seg-on-bg:var(--ch-400);--seg-on-fg:#04202E}
      .dash-period button{border:0;border-radius:5px;padding:.3rem .7rem;background:transparent;color:var(--ds-muted);font-size:.75rem;font-weight:600;cursor:pointer;transition:background-color .14s,color .14s}
      .dash-period button:hover:not(.is-active){color:var(--bs-emphasis-color)}
      .dash-period button.is-active{background:var(--seg-on-bg);color:var(--seg-on-fg)}
      .dash-chart{position:relative;padding:.9rem 1.05rem 1rem}
      .dash-chart-trend,.dash-chart-revenue{height:285px}
      .dash-user-list{padding:.2rem 1rem}
      .dash-user{display:flex;align-items:center;gap:.7rem;padding:.75rem .1rem;border-bottom:1px solid var(--ds-line)}
      .dash-user:last-child{border-bottom:0}
      .dash-user-rank{display:grid;place-items:center;flex:0 0 22px;height:22px;border-radius:var(--r-chip);background:var(--nu-sunken);color:var(--ds-muted);font-size:.72rem;font-weight:600}
      .dash-user-avatar{display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:9px;background:var(--lead-800);color:#fff;font-family:var(--f-display);font-size:.72rem;font-weight:700;box-shadow:inset 0 0 0 1px rgba(42,168,222,.35)}
      .dash-user-name{display:flex;flex-direction:column;gap:.1rem;min-width:0;flex:1}
      .dash-user-name strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.8125rem}
      .dash-user-name small{color:var(--ds-muted);font-size:.75rem}
      .dash-user>b{font-size:.8125rem;white-space:nowrap}
      .revenue-total{font-family:var(--f-display);font-size:.95rem;font-weight:700;color:var(--tx-ok);white-space:nowrap}
      .dash-side-stack{display:flex;flex-direction:column;gap:1rem;min-width:0}
      .dash-text-link{font-size:.78rem;font-weight:600;color:var(--tx-info);text-decoration:none;white-space:nowrap}
      .dash-text-link:hover{text-decoration:underline}
      .dash-request-list,.dash-stock-list{padding:.15rem 1.05rem .3rem}
      .dash-request{display:flex;align-items:center;gap:.75rem;justify-content:space-between;padding:.72rem 0;border-bottom:1px solid var(--ds-line)}
      .dash-request:last-child,.dash-stock-row:last-child{border-bottom:0}
      .dash-request>div{display:flex;flex-direction:column;gap:.12rem;min-width:0}
      .dash-request strong,.dash-stock-name strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.8125rem}
      .dash-request small,.dash-request time,.dash-stock-name small,.dash-stock-row>b small{color:var(--ds-muted);font-size:.75rem;font-weight:400}
      .dash-request time{white-space:nowrap}
      .dash-stock-row{display:flex;align-items:center;gap:.7rem;padding:.68rem 0;border-bottom:1px solid var(--ds-line)}
      .dash-stock-marker{flex:0 0 4px;height:30px;border-radius:2px;background:var(--st-warn)}
      .dash-stock-name{display:flex;flex-direction:column;gap:.12rem;min-width:0;flex:1}
      .dash-stock-row>b{font-size:.8125rem;text-align:right;white-space:nowrap}
      .dash-empty{display:flex;justify-content:center;align-items:center;min-height:80px;padding:1rem;text-align:center;color:var(--ds-muted);font-size:.8125rem}
      .dash-healthy{color:var(--tx-ok)}
      @media(max-width:1100px){.dash-grid-top{grid-template-columns:minmax(0,1.3fr) minmax(280px,.9fr)}.dash-grid-bottom{grid-template-columns:minmax(0,1fr) minmax(290px,.9fr)}}
      @media(max-width:900px){.dash-grid-top,.dash-grid-bottom{grid-template-columns:minmax(0,1fr)}.dash-side-stack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.dash-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.dash-kpi:nth-child(odd){border-left:0}.dash-kpi:nth-child(n+3){border-top:1px solid var(--ds-line)}.dash-chart-trend,.dash-chart-revenue{height:250px}}
      @media(max-width:600px){.dash-side-stack{grid-template-columns:minmax(0,1fr)}.dash-kpis{grid-template-columns:minmax(0,1fr)}.dash-kpi{border-left:0;border-top:1px solid var(--ds-line);min-height:0}.dash-kpi:first-child{border-top:0}.dash-jump .btn{flex:1 1 auto}}
    </style>
  </main>
</div>
<%- include('partials/footer') %>
